<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Open It</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
  }

  body {
    background: #0f0f1a;
    overflow-x: hidden;
  }

  /* ═══════════════════════════
     STARS BACKGROUND
  ═══════════════════════════ */
  .stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .star {
    position: absolute;
    width: 2px;
    height: 2px;
    background: white;
    border-radius: 50%;
    animation: twinkle var(--d) ease-in-out infinite;
    opacity: 0;
  }
  @keyframes twinkle {
    0%,100% { opacity:0; transform:scale(1); }
    50%      { opacity:0.9; transform:scale(1.8); }
  }

  /* ═══════════════════════════
     SLIDER OVERLAY
  ═══════════════════════════ */
  .slider-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
  }

  .panel {
    width: 100%;
    height: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1);
    position: relative;
    overflow: hidden;
  }

  .panel-top {
    background: linear-gradient(160deg, #0d0d1f 0%, #1a1040 100%);
    align-items: flex-end;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(108,99,255,0.2);
  }

  .panel-bottom {
    background: linear-gradient(160deg, #1a1040 0%, #0d0d1f 100%);
    align-items: flex-start;
    padding-top: 40px;
    border-top: 1px solid rgba(233,30,140,0.2);
  }

  .panel-top.open {
    transform: translateY(-100%);
  }
  .panel-bottom.open {
    transform: translateY(100%);
  }

  /* Panel grid lines decoration */
  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(108,99,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(108,99,255,0.05) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  /* Panel glow blobs */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    pointer-events: none;
  }
  .blob-purple {
    width: 400px; height: 400px;
    background: #6c63ff;
    top: -100px; left: -100px;
  }
  .blob-pink {
    width: 300px; height: 300px;
    background: #e91e8c;
    bottom: -80px; right: -80px;
  }

  /* ═══════════════════════════
     OPEN BUTTON
  ═══════════════════════════ */
  .open-btn-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Outer spinning ring */
  .spin-ring {
    position: absolute;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 2px dashed rgba(108,99,255,0.4);
    
